@LogiTrack_HostAddress = http://localhost:5260
@BearerToken = YOUR_JWT_TOKEN_HERE
@SessionId = session-checkout-2026

### 1. Register a Manager user
POST {{LogiTrack_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "manager_samir",
  "email": "samir@logitrack.io",
  "password": "ManagerPassword123!",
  "fullName": "Samir Patel",
  "fulfillmentCenter": "Warehouse A",
  "role": "Manager"
}

### 2. Login and obtain a JWT token
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "manager_samir",
  "password": "ManagerPassword123!"
}

### 3. Get all inventory items (Cached for 30s)
GET {{LogiTrack_HostAddress}}/api/inventory
Authorization: Bearer {{BearerToken}}
Accept: application/json

### 4. Create a new inventory item (Requires Manager role; invalidates cache)
POST {{LogiTrack_HostAddress}}/api/inventory
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "name": "Heavy Duty Forklift",
  "quantity": 4,
  "location": "Warehouse B"
}

### 5. Create a new order with session state persistence
POST {{LogiTrack_HostAddress}}/api/orders
Authorization: Bearer {{BearerToken}}
X-Session-Id: {{SessionId}}
Content-Type: application/json

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "name": "Conveyor Belt Roller",
      "quantity": 10,
      "location": "Warehouse A"
    },
    {
      "name": "Safety Helmet",
      "quantity": 25,
      "location": "Warehouse C"
    }
  ]
}

### 6. Get order by ID with items
GET {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{BearerToken}}
Accept: application/json

### 7. Get formatted order summary
GET {{LogiTrack_HostAddress}}/api/orders/1/summary
Authorization: Bearer {{BearerToken}}
Accept: application/json

### 8. Rehydrate / fetch orders by persistent session ID
GET {{LogiTrack_HostAddress}}/api/orders/session/{{SessionId}}
Authorization: Bearer {{BearerToken}}
Accept: application/json

### 9. Delete order by ID (Requires Manager role)
DELETE {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{BearerToken}}
